{
  "name": "@batterii/eslint-config-vurvey",
  "version": "2.0.0",
  "description": "Base lint configuration for Vurvey TypeScript projects",
  "license": "MIT",
  "author": "Batterii, LLC",
  "repository": "github:Batterii/eslint-config-vurvey",
  "files": [
    "oxlint/"
  ],
  "exports": {
    "./oxlint/.oxlintrc.json": "./oxlint/.oxlintrc.json"
  },
  "scripts": {
    "lint": "oxlint ./ -c ./oxlint/.oxlintrc.json",
    "format": "oxfmt . --check",
    "preversion": "npm run format && npm run lint",
    "prepublishOnly": "git push && git push --tags"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0"
  },
  "peerDependencies": {
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001"
  }
}
